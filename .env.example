# Copy this file to .env and fill it in. Never commit .env.
# Zoho data center: in (zoho.in), com, eu, com.au, jp, ca, sa
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Filled automatically by: python cli.py exchange-code <CODE>
ZOHO_REFRESH_TOKEN=
# Optional: where the local database lives (default data/crm.duckdb)
# ICP_DB_PATH=data/crm.duckdb
